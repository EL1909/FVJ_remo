# Copiar a backend/.env y completar. Nunca commitear .env con valores reales
# (.gitignore ya lo excluye).

SECRET_KEY=
# 'True' en desarrollo. En producción: 'False' (o directamente omitir la línea).
DEBUG=True

# Dominios permitidos, separados por coma. El default ya cubre producción
# (esfuerzovz.com) — en local alcanza con no definir esta variable.
ALLOWED_HOSTS=localhost,127.0.0.1,esfuerzovz.com,www.esfuerzovz.com

# Orígenes del frontend para CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://esfuerzovz.com

# Vacía = SQLite local (backend/db.sqlite3). En producción, Postgres:
#   DATABASE_URL=postgres://usuario:password@localhost:5432/fvj_remodelaciones
DATABASE_URL=

TIME_ZONE=America/Caracas

# Montaje bajo /fvj/ — no tocar salvo que cambie el subpath (ver settings.py).
URL_PREFIX=fvj/
FORCE_SCRIPT_NAME=
FRONTEND_URL=https://esfuerzovz.com/fvj

# Integración con EsfuerzoVZ — el token lo emite EsfuerzoVZ (Integraciones).
EVZ_API_URL=https://esfuerzovz.com
EVZ_API_TOKEN=

# Email transaccional (confirmaciones de cita, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FVJ Remodelaciones <no-reply@esfuerzovz.com>

# Web Push (evz_core.push) — vacías = notificaciones in-app funcionan pero
# sin aviso al dispositivo. Generar un par POR ENTORNO (no reutilizar el de
# desarrollo en producción) con: pip install py-vapid && vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=info@remodelacionesfvj.es
