# Bloques de FVJ Remodelaciones. deploy.sh copia este archivo a
# /etc/nginx/snippets/fvj.conf, que el server{} de puerto 443 de
# /etc/nginx/sites-available/esfuerzovz incluye con
#
#   include /etc/nginx/snippets/fvj.conf;
#
# y recarga nginx si cambió (con nginx -t antes). No editar la copia del
# servidor: el próximo deploy la reemplaza.

    location = /fvj {
        return 301 /fvj/;
    }

    # FVJ Remodelaciones - Frontend
    location /fvj/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/frontend/dist/;
        index index.html;
        try_files $uri $uri/ /fvj/index.html;
    }

    # FVJ Remodelaciones - Static & Media
    location /fvj/static/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/backend/static/;
    }
    # Archivos sin confirmar de evz_clerk (y cualquier otro private/): solo
    # salen por la API, que comprueba permisos. Va antes del alias de media.
    location ~ ^/fvj/media/.*/private/ {
        deny all;
    }
    location /fvj/media/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/backend/media/;
    }

    location ^~ /fvj/admin/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;
    }

    # FVJ Remodelaciones - Carga por chat (evz_clerk). La pantalla la sirve
    # Django, no el frontend; la API admite varias fotos por envío.
    location ^~ /fvj/clerk/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /fvj/api/clerk/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        client_max_body_size 60m;
    }

    # FVJ Remodelaciones - API
    location ^~ /fvj/api/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        client_max_body_size 25m;
    }
