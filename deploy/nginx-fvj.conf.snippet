# Bloque para FVJ Remodelaciones — agregar dentro del server{} de puerto 443
# en /etc/nginx/sites-available/esfuerzovz, en el mismo lugar/estilo que los
# bloques ya existentes de "MCnails". Después de pegarlo:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# (deploy.sh NO toca nginx — este bloque se agrega una sola vez a mano.)

    location = /fvj {
        return 301 /fvj/;
    }

    # FVJ Remodelaciones — Frontend
    location /fvj/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/frontend/dist/;
        index index.html;
        try_files $uri $uri/ /fvj/index.html;
    }

    # FVJ Remodelaciones — Static & Media
    location /fvj/static/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/backend/static/;
    }
    location /fvj/media/ {
        alias /home/efrain19091/projects/fvj_remo/fvj_remo/backend/media/;
    }

    location ^~ /fvj/admin/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FVJ Remodelaciones — API
    location ^~ /fvj/api/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }
